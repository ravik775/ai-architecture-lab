# Copy this file to .env and fill in real values before `docker compose up`.

# --- Service ---
SERVICE_NAME=genai-observability-service
APP_ENV=dev
LOG_LEVEL=INFO

# --- Observability provider switch ---
# collector (recommended/default) | langfuse_direct | langsmith_direct | console
OBSERVABILITY_PROVIDER=collector

# Used when OBSERVABILITY_PROVIDER=collector (default), points at the
# otel-collector service defined in docker-compose.yml. Leave as-is for Docker.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Fraction of traces to keep (head-based, ParentBased/TraceIdRatioBased).
# 1.0 = trace everything. Lower this once traffic makes 100% tracing
# expensive, e.g. 0.2 keeps 20% of traces. See README "Sampling".
TRACE_SAMPLING_RATIO=1.0

# How often the metrics pipeline flushes to its exporter.
METRICS_EXPORT_INTERVAL_SECONDS=15

# mTLS between the app and the collector - opt-in, off by default. Run
# certs/generate-certs.sh and `docker compose -f docker-compose.yml -f
# docker-compose.tls.yml up --build` to enable; that override file sets
# these for you. Leave as-is (false) for the plain docker-compose.yml path.
OTEL_TLS_ENABLED=false
OTEL_TLS_CA_FILE=/certs/ca.crt
OTEL_TLS_CLIENT_CERT_FILE=/certs/app.crt
OTEL_TLS_CLIENT_KEY_FILE=/certs/app.key

# --- API-key auth + RBAC for /chat* (see app/security/auth.py) ---
# Format: "key1:chat,force_trace;key2:chat" - semicolon-separated keys,
# each with a comma-separated permission list ("chat" required to call
# /chat*, "force_trace" required for the X-Force-Trace header to work).
# LEFT EMPTY: auth is disabled and /chat* is open - fine for a first run,
# not fine for anything beyond localhost. Generate real keys, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=demo-key-change-me:chat,force_trace

# --- Per-API-key rate limiting on /chat (OWASP LLM10, Unbounded Consumption) ---
# Token bucket, requests/minute, per key_id (or shared "anonymous" bucket if
# auth is disabled). <= 0 disables rate limiting entirely.
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# --- PII redaction (Layers 1/4 - see README "PII redaction") ---
# Regex-based structured-PII scrubbing on span attributes (Layer 1) and
# log messages (Layer 4). Layer 2 (Collector redaction processor) is
# collector-side config, not controlled by this flag. Only turn off for
# local debugging where you deliberately want to see raw content.
PII_REDACTION_ENABLED=true

# --- Langfuse credentials ---
# Used by the collector (default routing) AND by OBSERVABILITY_PROVIDER=langfuse_direct.
# Get these from Langfuse -> Project Settings -> API Keys.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx

# --- LangSmith credentials (optional alternate/second backend) ---
LANGSMITH_OTLP_ENDPOINT=https://api.smith.langchain.com/otel
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=genai-observability-service

# --- OpenRouter (via litellm) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_MODEL=openrouter/meta-llama/llama-3.1-8b-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LLM_REQUEST_TIMEOUT_SECONDS=30

# --- Health monitor sampling ---
HEALTH_CHECK_INTERVAL_SECONDS=2
HEALTH_SUMMARY_WINDOW_SECONDS=60

# --- HTTP server ---
HOST=0.0.0.0
PORT=8000
