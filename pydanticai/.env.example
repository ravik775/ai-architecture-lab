# Copy to .env and fill in real values before `docker compose up`.
# Never commit the real .env file.

APP_NAME=weather-intelligence-agent
ENV=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Host-side published port for weather-app in docker-compose.yml. Only
# change this if 8000 is already taken by something else on your machine.
WEATHER_APP_PORT=8000

# --- Database ---
DATABASE__URL=sqlite+aiosqlite:///./data/weather.db
DATABASE__BUSY_TIMEOUT_MS=5000
DATABASE__ECHO=false

# --- Cache ---
CACHE__CURRENT_WEATHER_TTL_SECONDS=30
CACHE__MAX_ENTRIES=512

# --- HTTP client (Open-Meteo) ---
HTTP_CLIENT__CONNECT_TIMEOUT_SECONDS=2
HTTP_CLIENT__READ_TIMEOUT_SECONDS=3
HTTP_CLIENT__WRITE_TIMEOUT_SECONDS=2
HTTP_CLIENT__POOL_TIMEOUT_SECONDS=2
HTTP_CLIENT__MAX_CONNECTIONS=50
HTTP_CLIENT__MAX_KEEPALIVE_CONNECTIONS=20
HTTP_CLIENT__HTTP2=true
HTTP_CLIENT__MAX_RETRIES=2
HTTP_CLIENT__TOTAL_LATENCY_BUDGET_SECONDS=4

# --- Weather provider ---
WEATHER_PROVIDER__OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
WEATHER_PROVIDER__OPEN_METEO_METEOSWISS_URL=https://api.open-meteo.com/v1/meteoswiss

# --- Agent / LiteLLM Proxy (OpenRouter gpt-oss-20b:free) ---
AGENT__LITELLM_BASE_URL=http://litellm-proxy:4000
AGENT__LITELLM_API_KEY=sk-local-virtual-key
AGENT__MODEL_ALIAS=weather-agent
AGENT__FALLBACK_MODEL_ALIAS=weather-agent-fallback
AGENT__TEMPERATURE=0.2
AGENT__MAX_OUTPUT_TOKENS=800
AGENT__REQUEST_TIMEOUT_SECONDS=20
AGENT__TOTAL_LATENCY_BUDGET_SECONDS=25

# Used by litellm-proxy itself (litellm_config.yaml), not by weather-app directly.
OPENROUTER_API_KEY=replace_me
LITELLM_MASTER_KEY=sk-local-virtual-key

# --- Scheduler ---
SCHEDULER__ENABLED=true
SCHEDULER__MISFIRE_GRACE_TIME_SECONDS=3600
SCHEDULER__BATCH_CONCURRENCY=5
SCHEDULER__CHECK_INTERVAL_MINUTES=15
SCHEDULER__MANUAL_TRIGGER_ENABLED=true

# --- Security ---
SECURITY__INTERNAL_API_TOKEN=change-me-internal-token
SECURITY__ALLOW_DIRECT_COORDINATES=true
# IP-based rate limiting (app/security/rate_limit.py) - in-memory per
# process, exempts /health/live and /health/ready.
SECURITY__RATE_LIMIT_ENABLED=true
SECURITY__RATE_LIMIT_REQUESTS_PER_MINUTE=10
SECURITY__MAX_HISTORY_RANGE_DAYS=92
SECURITY__MAX_PAGE_SIZE=100
# Demo-grade JWT auth (app/security/jwt_tokens.py). Change the secret
# before anything but local demo use - it's a single shared HS256 key with
# no rotation/revocation.
SECURITY__JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long
SECURITY__JWT_ALGORITHM=HS256
SECURITY__JWT_EXPIRES_MINUTES=60
# Only a JWT with this role can use the force_trace sampling override -
# see app/observability/sampling.py.
SECURITY__FORCE_TRACE_ROLE=trace_admin
# Optional bootstrap user, created once at startup if BOTH are set - there
# is no default user/password otherwise (deliberately - no hidden backdoor
# account). Idempotent: leaving these set across restarts does not reset
# the password if the user already exists. Uncomment to get a ready-to-use
# trace_admin login after `docker compose up`:
# SECURITY__BOOTSTRAP_ADMIN_USERNAME=admin
# SECURITY__BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
# SECURITY__BOOTSTRAP_ADMIN_ROLE=trace_admin
# Signs the browser cookie backing NiceGUI's app.storage.user (the UI's
# session: login token, Correlation ID, "Trace" checkbox preference).
# Distinct from JWT_SECRET above - rotating one doesn't affect the other.
SECURITY__UI_STORAGE_SECRET=change-me-ui-storage-secret-at-least-32-bytes

# --- Observability ---
OBSERVABILITY__OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OBSERVABILITY__OTEL_ENABLED=true
OBSERVABILITY__SERVICE_NAME=weather-intelligence-agent
OBSERVABILITY__METRICS_EXPORT_INTERVAL_SECONDS=15
OBSERVABILITY__CONSOLE_EXPORT=false
# /health/live and /health/ready traces are rate-limited to at most one
# sampled trace per this many seconds. Set to 60 for a tighter window while
# actively debugging. To force-sample one specific health-check request
# regardless of this limit, the caller needs BOTH force_trace=true AND a
# valid JWT with the SECURITY__FORCE_TRACE_ROLE role, carried via baggage
# (not a normal Authorization header - see app/observability/sampling.py
# for why):
#   TOKEN=$(curl -s -X POST http://localhost:8000/v1/auth/login \
#     -H "Content-Type: application/json" \
#     -d '{"username":"...","password":"..."}' | jq -r .access_token)
#   curl -H "baggage: force_trace=true,auth_token=$TOKEN" http://localhost:8000/health/live
OBSERVABILITY__HEALTH_CHECK_SAMPLE_INTERVAL_SECONDS=300
# /metrics is served on its OWN port/server (prometheus_client's own WSGI
# server), separate from the main app port above - so it can be firewalled
# to internal-only access later (e.g. left unpublished in docker-compose.yml,
# reachable only by other containers on weather-net such as prometheus)
# without touching the public API/UI port at all. 9464 is OTel's documented
# conventional default port for a Prometheus exporter.
OBSERVABILITY__METRICS_PORT=9464
OBSERVABILITY__METRICS_BIND_HOST=0.0.0.0
OBSERVABILITY__METRICS_SERVER_ENABLED=true

# Collector-side (not app-side - see ObservabilitySettings' note), consumed
# by docker/otel-collector-config.yaml's tail_sampling processor. 100 = keep
# every successful trace; failed-request traces are always kept regardless
# of this value. `otel-collector` is a core service (not gated behind
# --profile observability) - only Tempo/Grafana/Prometheus are, so traces
# are collected either way, just not queryable via Grafana until that
# profile is up.
OTEL_TAIL_SAMPLING_BASELINE_PERCENT=100

# --- UI ---
UI__DEBUG_MODE=false
UI__BATCH_MANUAL_TRIGGER_VISIBLE=true

# --- Grafana (observability profile only) ---
GF_SECURITY_ADMIN_PASSWORD=admin
