{
  "title": "Weather App - API & UI Overview",
  "uid": "weather-api-ui-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "tags": ["weather-intelligence-agent"],
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate by route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum by (route, status_code) (rate(http_requests_total[5m]))", "legendFormat": "{{route}} [{{status_code}}]" }
      ]
    },
    {
      "id": 2,
      "title": "HTTP p95 latency by route",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 3,
      "title": "Cache hit ratio",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(cache_hits_total[5m])) / clamp_min(sum(rate(cache_hits_total[5m])) + sum(rate(cache_misses_total[5m])), 1e-9)" }
      ]
    },
    {
      "id": 4,
      "title": "Active outbound requests to Open-Meteo",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [{ "expr": "active_outbound_requests" }]
    },
    {
      "id": 5,
      "title": "SQLite busy/locked errors",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "targets": [{ "expr": "sum(rate(sqlite_busy_errors_total[5m]))" }]
    },
    {
      "id": 6,
      "title": "Scheduler misfires",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
      "targets": [{ "expr": "sum(rate(scheduler_misfires_total[5m]))" }]
    },
    {
      "id": 7,
      "title": "Weather lookup p95 latency by path type (dependency health)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, path_type) (rate(weather_request_duration_seconds_bucket[5m])))", "legendFormat": "{{path_type}}" }
      ]
    },
    {
      "id": 8,
      "title": "Open-Meteo call duration (p95) and failures",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(open_meteo_request_duration_seconds_bucket[5m])))", "legendFormat": "{{provider}} p95" },
        { "expr": "sum by (provider, error_type) (rate(open_meteo_failures_total[5m]))", "legendFormat": "{{provider}} {{error_type}} failures" }
      ]
    },
    {
      "id": 9,
      "title": "Gradio UI operation p95 duration",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(ui_operation_duration_seconds_bucket[5m])))", "legendFormat": "{{operation}}" }
      ]
    }
  ]
}
