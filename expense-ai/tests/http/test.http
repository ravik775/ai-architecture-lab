### Environment Variable
@host = http://localhost:8000

### 1. Health Check
GET {{host}}/health

### 2. Analyze Single Expense (Auto-creates analysis_id)
# @name analyzeSingleExpense
POST {{host}}/api/v1/expenses/analyze
Content-Type: application/json

{
    "submitted_by": "John Doe",
    "submitted_date": "2026-07-30T02:45:00Z",
    "currency": "INR",
    "expenses": [
        {
            "description": "Future Flight",
            "amount": 100.0,
            "quantity": 1,
            "expense_date": "2026-07-30T02:45:00Z",
            "merchant": "Airline",
            "category": "Travel"
        }
    ]
}

> {%
    // Automatically stores the analysis_id of whichever request was just executed!
    client.global.set("latest_analysis_id", response.body.analysis_id);
%}

### 3. Approve Expense (Uses dynamic analysis_id from request above)
# @timeout 120s
POST {{host}}/api/v1/expenses/{{analyzeSingleExpense.response.body.analysis_id}}/approve
Content-Type: application/json

{
    "action": "APPROVED",
    "reason": "Expense as per plan"
}

### 4. Analyze Large Expense Payload (10 Items - Requires Review)
# @name analyzeLargeExpenses
# @timeout 120s
POST {{host}}/api/v1/expenses/analyze
Content-Type: application/json

{
    "submitted_by": "John Doe",
    "currency": "INR",
    "expenses": [
