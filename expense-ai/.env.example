AGENTIC_EXPENSE=true

DATA__DATABASE_URL=postgresql://expense_ai:local_password@localhost:5432/expense_ai
DATA__DATABASE_SSLMODE=disable

RUNTIME__TIMEOUT_SECONDS=10
RUNTIME__MAX_RETRIES=1

RAG__PERSIST_DIRECTORY=.chroma

OBSERVABILITY__TRACING_ENABLED=true
OBSERVABILITY__METRICS_ENABLED=true
OBSERVABILITY__CONSOLE_TRACE_EXPORTER_ENABLED=true
OBSERVABILITY__CONSOLE_METRIC_EXPORTER_ENABLED=false