# Copy to .env and fill in real values. Never commit the real .env file.

# OpenRouter (https://openrouter.ai/settings/keys) — used for the LLM call
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=qwen/qwen3-coder:free

# Postgres (chat_audit_log)
POSTGRES_PASSWORD=replace-with-a-strong-password

# Keycloak admin console (dev-mode only — not a production credential pattern)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-strong-password
