{
  "realm": "loan-platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "loan-officer", "description": "Can create and view loans" },
      { "name": "loan-admin", "description": "Can approve/override loan decisions" }
    ]
  },
  "requiredActions": [
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": false, "priority": 10 },
    { "alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": true, "defaultAction": false, "priority": 30 },
    { "alias": "UPDATE_PROFILE", "name": "Update Profile", "providerId": "UPDATE_PROFILE", "enabled": true, "defaultAction": false, "priority": 40 },
    { "alias": "VERIFY_EMAIL", "name": "Verify Email", "providerId": "VERIFY_EMAIL", "enabled": true, "defaultAction": false, "priority": 50 },
    { "alias": "VERIFY_PROFILE", "name": "Verify Profile", "providerId": "VERIFY_PROFILE", "enabled": false, "defaultAction": false, "priority": 90 },
    { "alias": "terms_and_conditions", "name": "Terms and Conditions", "providerId": "TERMS_AND_CONDITIONS", "enabled": false, "defaultAction": false, "priority": 20 },
    { "alias": "update_user_locale", "name": "Update User Locale", "providerId": "update_user_locale", "enabled": true, "defaultAction": false, "priority": 1000 }
  ],
  "clients": [
    {
      "clientId": "api-gateway",
      "publicClient": false,
      "secret": "changeit-in-non-dev",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8085/*"],
      "protocolMappers": [
        {
          "name": "tenant-attribute-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    { "clientId": "loan-service", "bearerOnly": true, "protocol": "openid-connect" }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice123", "temporary": false }],
      "attributes": { "tenant": ["tenant-a"] },
      "realmRoles": ["loan-officer"]
    },
    {
      "username": "bob",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob123", "temporary": false }],
      "attributes": { "tenant": ["tenant-b"] },
      "realmRoles": ["loan-officer", "loan-admin"]
    }
  ]
}