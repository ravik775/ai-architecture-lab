# Copy this file to .env and fill in the key(s) for whichever provider(s)
# you'll use. Only one is required — pick the provider in the app's sidebar.

# Gemini (Google AI Studio) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Hugging Face (Serverless Inference API) — https://huggingface.co/settings/tokens
HF_TOKEN=
